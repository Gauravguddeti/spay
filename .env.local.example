# REQUIRED - NextAuth session encryption key (generate: openssl rand -base64 32)
AUTH_SECRET="replace-with-long-random-secret"

# REQUIRED - Neon database connection string
DATABASE_URL="postgresql://user:password@host:5432/spendly"

# REQUIRED - Neon Auth base URL used by createNeonAuth server runtime
# Obtain this from your Neon Auth project/environment settings
NEON_AUTH_BASE_URL="https://your-neon-auth-host"

# REQUIRED - Neon Auth cookie signing secret (must be at least 32 characters)
# Generate: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET="replace-with-64-char-hex-secret"

# OPTIONAL - Google OAuth credentials for Gmail integration
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Backward-compatible aliases supported by gmail integration refresh flow
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# OPTIONAL - Upstash Redis for distributed middleware rate limiting
# Obtain from https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"
